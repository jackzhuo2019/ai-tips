---
import BaseLayout from "../layouts/BaseLayout.astro";
import TipCard from "../components/TipCard.astro";
import CategoryNav from "../components/CategoryNav.astro";
import { getCollection } from "astro:content";
import { CATEGORIES, SITE_TITLE, SITE_DESCRIPTION } from "../consts";

const allTips = await getCollection("tips", (t) => !t.data.draft);
const tips = allTips.sort((a, b) => +new Date(b.data.date) - +new Date(a.data.date));
const recent = tips.slice(0, 6);
---

<BaseLayout>
  <section class="text-center py-12 sm:py-16">
    <h1 class="text-4xl sm:text-5xl font-bold tracking-tight mb-4">
      AI 使用技巧合集
    </h1>
    <p class="text-lg text-[var(--text-muted)] max-w-2xl mx-auto mb-8">
      {SITE_DESCRIPTION}
    </p>
    <button
      id="hero-search-trigger"
      class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg border border-[var(--border)] bg-[var(--bg-subtle)] text-sm text-[var(--text-muted)] hover:bg-[var(--bg-muted)] transition-colors"
    >
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      搜索文章...
      <kbd class="hidden sm:inline-flex items-center px-1.5 py-0.5 text-xs border border-[var(--border)] rounded ml-4">⌘K</kbd>
    </button>
  </section>

  <section class="mb-12">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-lg font-bold">浏览分类</h2>
    </div>
    <CategoryNav />
  </section>

  <section>
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-lg font-bold">最新技巧</h2>
      {tips.length > 6 && (
        <span class="text-sm text-[var(--text-muted)]">共 {tips.length} 篇</span>
      )}
    </div>
    <div class="grid sm:grid-cols-2 gap-4">
      {recent.map((tip) => (
        <TipCard tip={tip} />
      ))}
    </div>
    {tips.length === 0 && (
      <p class="text-center text-[var(--text-muted)] py-12">
        还没有内容，敬请期待。
      </p>
    )}
  </section>
</BaseLayout>

<script>
  const heroSearch = document.getElementById("hero-search-trigger");
  heroSearch?.addEventListener("click", () => {
    if (window.openSearch) window.openSearch();
  });
</script>
