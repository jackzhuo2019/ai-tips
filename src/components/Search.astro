---
---

<div class="relative">
  <div class="relative">
    <svg
      class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-[var(--text-subtle)]"
      fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
    </svg>
    <input
      type="text"
      id="tip-search"
      placeholder="搜索技巧..."
      class="w-full pl-10 pr-4 py-2.5 rounded-lg border border-[var(--border)] bg-[var(--bg-subtle)] text-sm focus:outline-none focus:ring-2 focus:ring-brand-400 focus:border-transparent"
    />
  </div>
  <div id="search-results" class="hidden absolute z-50 w-full mt-2 rounded-lg border border-[var(--border)] bg-[var(--bg)] shadow-lg max-h-96 overflow-y-auto"></div>
</div>

<script is:inline>
  (function () {
    const input = document.getElementById("tip-search");
    const results = document.getElementById("search-results");
    if (!input || !results) return;

    let searchData = [];
    let loaded = false;

    async function loadData() {
      if (loaded) return;
      try {
        const res = await fetch("/search-index.json");
        searchData = await res.json();
        loaded = true;
      } catch (e) {}
    }

    input.addEventListener("focus", loadData);

    input.addEventListener("input", (e) => {
      const query = e.target.value.trim().toLowerCase();
      if (!query) {
        results.classList.add("hidden");
        return;
      }
      loadData().then(() => {
        const matched = searchData.filter(
          (item) =>
            item.title.toLowerCase().includes(query) ||
            item.description.toLowerCase().includes(query) ||
            item.tags.some((t) => t.toLowerCase().includes(query))
        );
        if (matched.length === 0) {
          results.innerHTML =
            '<div class="p-4 text-sm text-[var(--text-muted)]">没有找到相关技巧</div>';
        } else {
          results.innerHTML = matched
            .slice(0, 8)
            .map(
              (item) =>
                `<a href="${item.url}" class="block px-4 py-3 hover:bg-[var(--bg-muted)] border-b border-[var(--border)] last:border-0"><div class="font-medium text-sm">${item.title}</div><div class="text-xs text-[var(--text-muted)] mt-0.5">${item.description}</div></a>`
            )
            .join("");
        }
        results.classList.remove("hidden");
      });
    });

    document.addEventListener("click", (e) => {
      if (!input.contains(e.target) && !results.contains(e.target)) {
        results.classList.add("hidden");
      }
    });
  })();
</script>
