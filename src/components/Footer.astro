---
import { SITE_TITLE, url } from "../consts";
const year = new Date().getFullYear();
---

<footer class="border-t border-[var(--border)] mt-16">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-2 text-sm text-[var(--text-muted)]">
        <span class="inline-flex items-center justify-center w-6 h-6 rounded bg-brand-600 text-white text-xs font-bold">
          AI
        </span>
        <span>{SITE_TITLE}</span>
      </div>
      <div class="flex items-center gap-4 text-sm text-[var(--text-muted)]">
        <a href={url("rss.xml")} class="hover:text-brand-600 transition-colors flex items-center gap-1">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M6.18 15.64a2.18 2.18 0 012.18 2.18C8.36 19 7.38 20 6.18 20A2.18 2.18 0 014 17.82a2.18 2.18 0 012.18-2.18M4 4.44A15.56 15.56 0 0119.56 20h-2.83A12.73 12.73 0 004 7.27V4.44m0 5.66a9.9 9.9 0 019.9 9.9h-2.83A7.07 7.07 0 004 12.93V10.1z" />
          </svg>
          RSS
        </a>
        <span>© 2024-{year}</span>
      </div>
    </div>
  </div>
</footer>
